<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ series_title }}</title>
    <link rel="stylesheet" href="{{ stylesheet_href }}" />
  </head>
  <body style="background-color: {{ prelude.paper }};">
    {% set page_idx = namespace(n=0) %}
    {% macro page_side() -%}
    {%- set page_idx.n = page_idx.n + 1 -%}
    page-side-{%- if page_idx.n % 2 == 1 -%}left{%- else -%}right{%- endif -%}
    {%- endmacro %}

    <div
      class="page page-cover {{ page_side() }}"
      style="background-color: {{ prelude.cover_bleed }};"
    >
      <img src="{{ front_cover_href }}" alt="" />
    </div>

    {% for _ in range(blank_start) %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endfor %}

    {% if include_series_page %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endif %}

    {% if include_series_page %}
    <div
      class="page page-series {{ page_side() }}"
      style="--prelude-accent: {{ prelude.accent }}; background-color: {{ prelude.series_bg }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ prelude.series_bg }}; color: {{ prelude.series_ink }};"
      >
        <p class="series-subtitle">{{ series_subtitle }}</p>
      </div>
    </div>
    {% endif %}

    {% if include_series_page %}
    {% for _ in range(blank_after_series) %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endfor %}
    {% endif %}

    {% for ch in chapters %}
    {% if not include_series_page and loop.first %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endif %}
    <div
      class="page page-title-a {{ page_side() }}"
      style="--zine-accent: {{ ch.background_color }}; background-color: {{ ch.background_color }}; color: {{ ch.title_ink }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ ch.background_color }}; color: {{ ch.title_ink }};"
      >
        <p class="zine-index-roman" style="color: {{ ch.title_ink }};">{{ ch.roman_numeral }}</p>
        <h1 style="color: {{ ch.title_ink }};">{{ ch.title }}</h1>
      </div>
    </div>
    <div
      class="page page-title-b title-b-quiet {{ ch.title_hero_class }}{% if ch.generator == 'field' %} print-field-figures{% endif %} {{ page_side() }}"
      style="--zine-accent: {{ ch.background_color }}; background-color: {{ ch.background_color }}; color: {{ ch.title_ink }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ ch.background_color }}; color: {{ ch.title_ink }};"
      >
        <div class="figure-wrap">
          <div class="hero-slot">
            <img class="hero-figure" src="{{ ch.title_right_href }}" alt="" />
          </div>
        </div>
      </div>
    </div>
    {% if not include_series_page and loop.first %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endif %}

    {% for spread in ch.spreads %}
    <div
      class="page page-text {{ page_side() }}"
      style="--zine-accent: {{ ch.background_color }}; color: {{ ch.chapter_ink }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ ch.accent_light_text }};"
      >
        <div
          class="print-running-head"
          style="color: {{ ch.chapter_ink }};"
        >
          {{ ch.title }}
        </div>
        <div
          class="print-folio"
          style="color: {{ ch.chapter_ink }};"
        >
          {{ spread.folio_text }}
        </div>
        <div class="prose" style="color: {{ ch.chapter_ink }};">{{ spread.prose_html | safe }}</div>
      </div>
    </div>
    <div
      class="page page-image {{ spread.image_page_class }}{% if not spread.image_href %} image-page-blank{% endif %}{% if ch.generator == 'field' %} print-field-figures{% endif %} {{ page_side() }}"
      style="--zine-accent: {{ ch.background_color }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ ch.accent_light_art }};"
      >
        <div
          class="print-running-head"
          style="color: {{ ch.chapter_ink }};"
        >
        </div>
        <div
          class="print-folio"
          style="color: {{ ch.chapter_ink }};"
        >
          {{ spread.folio_image }}
        </div>
        <div class="figure-wrap">
          {% if spread.image_href %}
          <div class="hero-slot">
            <img class="hero-figure" src="{{ spread.image_href }}" alt="" />
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
    {% endfor %}

    {% for _ in range(blank_end) %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ epilogue_paper }};"></div>
    </div>
    {% endfor %}

    {% if include_series_page %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ epilogue_paper }};"></div>
    </div>
    <div
      class="page page-series page-series-epilogue {{ page_side() }}"
      style="--epilogue-accent: {{ epilogue_accent }}; background-color: {{ epilogue_paper }};"
    >
      <div
        class="page-inner"
        style="background-color: {{ epilogue_paper }}; color: {{ epilogue_accent }};"
      >
        <p class="series-epilogue-body">
          Join us in reclaiming technology today, and help make technology work for people. Get involved at
          <a href="https://aptecom.org/">aptecom.org</a>.
        </p>
      </div>
    </div>
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ epilogue_paper }};"></div>
    </div>
    {% else %}
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    <div class="page page-blank paper {{ page_side() }}">
      <div class="page-inner" style="background-color: {{ prelude.paper }};"></div>
    </div>
    {% endif %}

    <div
      class="page page-cover-back {{ page_side() }}"
      style="background-color: {{ prelude.cover_bleed }};"
    >
      <img src="{{ back_cover_href }}" alt="" />
    </div>
  </body>
</html>
